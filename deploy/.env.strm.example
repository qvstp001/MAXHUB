# 复制到仓库根目录的 .env.strm，再填写本机实际路径。
PEACH_IMAGE=ghcr.io/qvstp001/qmaxhub:latest
PEACH_MEDIA_ROOT=/srv/media/strm
PEACH_DATA_ROOT=/srv/peach-strm/data
PEACH_UID=1000
PEACH_GID=1000
PEACH_BIND=127.0.0.1
PEACH_PORT=18100
# 仅在可信 STRM 来源的 HTTPS 跳转命中 Fake-IP DNS 时填写来源 origin。
# 多个来源用分号分隔；不填写 STRM 路径、查询参数或令牌。
PEACH_STRM_FAKE_IP_ORIGINS=
