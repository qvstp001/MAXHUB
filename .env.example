ADMIN_PASSWORD=replace-with-a-long-password
# 宿主机 STRM、NFO、图片所在的同一个目录；Windows 路径建议 D:/Media/JAV
MEDIA_PATH=D:/Media/JAV
# 8096 被现有 Emby 占用时，可先改成 8097 试运行
QMAXHUB_PORT=8096
PUBLIC_URL=http://192.168.1.10:8096
# 必须是 Windows / Android 客户端都能访问的 LitePan 反代入口
LITEPAN_PUBLIC_URL=http://192.168.1.10:42069
SCAN_INTERVAL=1800
# 通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
