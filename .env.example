# 飞牛中 STRM、NFO、图片的实际路径；下方仅为示例。Windows 可使用 D:/Media/JAV
MEDIA_PATH=/vol1/1000/media/strm
# 对外访问端口，可按需修改；容器内部端口也可通过 PORT 单独配置
MAXHUB_PORT=8096
# 稳定版本镜像；改为 latest 可跟随 main 的已验证构建
MAXHUB_IMAGE_TAG=0.2.0
# 换目录或换 Compose 项目时保持此值；接旧库时填写旧数据卷的实际名称
MAXHUB_DATA_VOLUME=maxhub-data
PUBLIC_URL=http://192.168.1.10:8096
# 302 反代播放入口，可使用任意工具、主机、端口及路径前缀
# 例如 https://proxy.example:10443/media；留空时使用 STRM 地址直连（302 跳转）
PLAYBACK_PROXY_URL=
SCAN_INTERVAL=1800
