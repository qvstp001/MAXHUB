# 未设置或留空时使用默认初始密码 qmaxhub123456；自定义密码至少 10 个字符
ADMIN_PASSWORD=qmaxhub123456
# 宿主机视频、STRM、NFO、图片所在的目录；Windows 路径建议 D:/Media/JAV
MEDIA_PATH=D:/Media/JAV
# 对外访问端口，可按需修改；容器内部端口也可通过 PORT 单独配置
QMAXHUB_PORT=8096
PUBLIC_URL=http://192.168.1.10:8096
# 302 反代播放入口，可使用任意工具、主机、端口及路径前缀
# 例如 https://proxy.example:10443/media；留空时使用 STRM 地址直连（302 跳转）
PLAYBACK_PROXY_URL=
SCAN_INTERVAL=1800
# 通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
